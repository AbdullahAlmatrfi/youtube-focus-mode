{
  "manifest_version": 3,
  "name": "Minimal YouTube",
  "version": "4.0.0",
  "description": "Transform YouTube into a distraction-free, search-first experience.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send Feedback"
  },
  "icons": {
    "16": "icons/Logo_icon.png",
    "48": "icons/Logo_icon.png",
    "128": "icons/Logo_icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://suggestqueries.google.com/"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.html"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}