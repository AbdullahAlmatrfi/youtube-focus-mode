{
  "manifest_version": 3,
  "name": "Minimal YouTube",
  "version": "4.0.0",
  "description": "Transform YouTube into a distraction-free, search-first experience.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["https://suggestqueries.google.com/"],
  "host_permissions": [
    "https://suggestqueries.google.com/"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.html"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
